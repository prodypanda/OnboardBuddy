{
  "name": "@prodypanda/onboardbuddy",
  "version": "0.1.0",
  "description": "Character-guided onboarding tours for React and Next.js.",
  "homepage": "https://github.com/prodypanda/OnboardBuddy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prodypanda/OnboardBuddy.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/prodypanda/OnboardBuddy/issues"
  },
  "license": "MIT",
  "keywords": [
    "react",
    "nextjs",
    "onboarding",
    "product-tour",
    "guided-tour",
    "tooltip",
    "walkthrough",
    "mascot"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "import": "./src/index.tsx"
    },
    "./styles.css": "./src/styles.css"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./styles.css": "./dist/styles.css"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/styles.css"
  ],
  "scripts": {
    "build": "tsup src/index.tsx --format esm --dts && cp src/styles.css dist/styles.css",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
